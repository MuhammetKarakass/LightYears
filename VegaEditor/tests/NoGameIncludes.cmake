file(GLOB_RECURSE files "${SOURCE_ROOT}/VegaEditor/src/*" "${SOURCE_ROOT}/VegaEditor/include/*")
foreach(file IN LISTS files)
	if(IS_DIRECTORY "${file}")
		continue()
	endif()
	file(READ "${file}" source)
	file(RELATIVE_PATH relative "${SOURCE_ROOT}/VegaEditor" "${file}")
	if(source MATCHES "LightYears(Game|Visual)[/\\\\]")
		message(FATAL_ERROR "${relative} names a game-specific path")
	endif()
	string(REGEX MATCHALL "#[ \t]*include[ \t]*[<\"][^>\"\r\n]+[>\"]" includes "${source}")
	foreach(include IN LISTS includes)
		string(REGEX REPLACE ".*[<\"]([^>\"]+)[>\"]" "\\1" header "${include}")
		if(EXISTS "${SOURCE_ROOT}/LightYearsGame/include/${header}" OR EXISTS "${SOURCE_ROOT}/LightYearsVisual/include/${header}")
			message(FATAL_ERROR "${relative} includes game header ${header}")
		endif()
	endforeach()
endforeach()
message(STATUS "Editor game dependency guard passed (no exceptions)")
