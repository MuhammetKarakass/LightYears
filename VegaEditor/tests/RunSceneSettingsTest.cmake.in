file(READ "@CMAKE_SOURCE_DIR@/LightYearsGame/assets/scenes/sandbox.scene.json" scene)
string(JSON scene SET "${scene}" settings futureSetting "\"preserve me\"")
file(WRITE "@VEGA_SETTINGS_SOURCE@" "${scene}")
execute_process(COMMAND "${VEGA_EDITOR}" --editor-script "@CMAKE_CURRENT_BINARY_DIR@/scripts/scene-settings.vegascript"
	WORKING_DIRECTORY "@CMAKE_CURRENT_BINARY_DIR@" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
	message(FATAL_ERROR "Scene settings script failed: ${result}")
endif()
file(READ "@VEGA_SETTINGS_SAVED@" saved)
string(JSON unknown GET "${saved}" settings futureSetting)
if(NOT unknown STREQUAL "preserve me")
	message(FATAL_ERROR "Unknown scene setting lost on disk")
endif()
foreach(capture IN ITEMS "@VEGA_SETTINGS_BEFORE@" "@VEGA_SETTINGS_AFTER@")
	if(NOT EXISTS "${capture}")
		message(FATAL_ERROR "Missing scene settings capture: ${capture}")
	endif()
endforeach()
