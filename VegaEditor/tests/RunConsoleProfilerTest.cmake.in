set(root "@CMAKE_CURRENT_BINARY_DIR@/console-test-assets")
file(MAKE_DIRECTORY "${root}")
file(COPY "@CMAKE_SOURCE_DIR@/LightYearsGame/assets/" DESTINATION "${root}")
file(WRITE "${root}/scripts/console-print.lua" "function on_create(self)\n\tprint('Console Lua hello', 42, true)\nend\n")
file(WRITE "${root}/scripts/console-error.lua" "function on_create(self)\n\terror('Console Lua failure')\nend\n")
execute_process(COMMAND "${VEGA_EDITOR}" --asset-root "${root}" --editor-script
	"@CMAKE_CURRENT_BINARY_DIR@/scripts/console-profiler.vegascript" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
	message(FATAL_ERROR "VegaEditorConsoleProfiler failed: ${result}")
endif()
file(READ "@CMAKE_CURRENT_BINARY_DIR@/Saved/console-profile.json" capture)
string(JSON format GET "${capture}" format)
string(JSON frames LENGTH "${capture}" frames)
if(NOT format STREQUAL "vega.profile" OR frames LESS 5)
	message(FATAL_ERROR "Invalid or empty profile capture")
endif()
