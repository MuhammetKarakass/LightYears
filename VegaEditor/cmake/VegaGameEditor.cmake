include_guard(GLOBAL)
set(VEGA_EDITOR_SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/..")

function(vega_add_game_editor name)
	set(VEGA_EDITOR_SOURCE_DIR "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/..")
	cmake_parse_arguments(GAME "" "MODULE;RUNTIME;PROJECT;ENTRY;CORE" "" ${ARGN})
	foreach(required MODULE RUNTIME PROJECT ENTRY)
		if(NOT GAME_${required})
			message(FATAL_ERROR "vega_add_game_editor requires ${required}")
		endif()
	endforeach()
	if(NOT GAME_CORE)
		set(GAME_CORE VegaEditorCore)
	endif()
	add_executable(${name} "${GAME_ENTRY}" "${VEGA_EDITOR_SOURCE_DIR}/src/EditorProject.cpp")
	target_link_libraries(${name} PRIVATE ${GAME_MODULE} ${GAME_CORE})
	target_compile_definitions(${name} PRIVATE VEGA_DEFAULT_PROJECT_FILE="${GAME_PROJECT}"
		VEGA_SOURCE_ROOT="${CMAKE_SOURCE_DIR}" VEGA_BUILD_ROOT="${CMAKE_BINARY_DIR}")
	# Hosts share binaries, while their synchronized assets have separate roots.
	set_target_properties(${name} PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/VegaEditor")
	add_dependencies(${name} ${GAME_RUNTIME})
	ly_enable_warnings(${name})
	if(MSVC)
		target_link_options(${name} PRIVATE /INCREMENTAL:NO)
	endif()
	if(WIN32)
		target_link_libraries(${name} PRIVATE sfml-main)
		if(CMAKE_BUILD_TYPE STREQUAL "Release")
			set_target_properties(${name} PROPERTIES WIN32_EXECUTABLE TRUE)
		endif()
	endif()
	foreach(runtime sfml-graphics sfml-window sfml-system sfml-audio box2d)
		CopyRuntimeLibToTarget(${runtime} ${name})
	endforeach()
	get_target_property(imgui_type ImGui-SFML TYPE)
	if(imgui_type STREQUAL "SHARED_LIBRARY")
		CopyRuntimeLibToTarget(ImGui-SFML ${name})
	endif()
	file(READ "${GAME_PROJECT}" project)
	get_filename_component(directory "${GAME_PROJECT}" DIRECTORY)
	set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${GAME_PROJECT}")
	string(JSON assets ERROR_VARIABLE error GET "${project}" editor assetRoot)
	if(error)
		set(assets ".")
	endif()
	cmake_path(ABSOLUTE_PATH assets BASE_DIRECTORY "${directory}" NORMALIZE)
	set(destination "${name}-assets")
	if(name STREQUAL "VegaEditor")
		set(destination assets)
	endif()
	add_custom_target(${name}Assets ALL COMMAND ${CMAKE_COMMAND} -E copy_directory
		"${assets}" "$<TARGET_FILE_DIR:${name}>/${destination}")
	string(JSON visual ERROR_VARIABLE error GET "${project}" editor visualAssets)
	if(NOT error AND NOT visual STREQUAL "")
		cmake_path(ABSOLUTE_PATH visual BASE_DIRECTORY "${directory}" NORMALIZE)
		add_custom_command(TARGET ${name}Assets POST_BUILD
			COMMAND ${CMAKE_COMMAND} -E $<IF:$<CONFIG:Debug>,true,copy_directory>
			"${visual}" "$<TARGET_FILE_DIR:${name}>/visual")
	endif()
	add_dependencies(${name} ${name}Assets)
endfunction()
