file(GLOB_RECURSE sources "${SOURCE_ROOT}/Modules/Sky/*.h" "${SOURCE_ROOT}/Modules/Sky/*.cpp"
	"${SOURCE_ROOT}/Modules/GAS/*.h" "${SOURCE_ROOT}/Modules/GAS/*.cpp")
foreach(file IN LISTS sources)
	file(READ "${file}" source)
	if(source MATCHES "#[ \t]*include[^\r\n]*(visual/|presentation/|gameFramework/|gameplay/)")
		message(FATAL_ERROR "Engine module imports game code: ${file}")
	endif()
	string(REGEX MATCHALL "#[ \t]*include[ \t]*[<\"][^>\"\r\n]+[>\"]" includes "${source}")
	foreach(include IN LISTS includes)
		string(REGEX REPLACE ".*[<\"]([^>\"]+)[>\"]" "\\1" header "${include}")
		if(EXISTS "${SOURCE_ROOT}/LightYearsGame/include/${header}" OR EXISTS "${SOURCE_ROOT}/LightYearsVisual/include/${header}")
			message(FATAL_ERROR "Engine module includes game header ${header}: ${file}")
		endif()
	endforeach()
endforeach()
# Legacy authoring paths remain byte-identical compatibility copies for LightYears.
file(GLOB shaders "${SOURCE_ROOT}/Modules/Sky/assets/shaders/*")
foreach(file IN LISTS shaders)
	get_filename_component(name "${file}" NAME)
	file(SHA256 "${file}" module)
	file(SHA256 "${SOURCE_ROOT}/LightYearsVisual/assets/shaders/${name}" legacy)
	if(NOT module STREQUAL legacy)
		message(FATAL_ERROR "Legacy shader differs from Sky module: ${name}")
	endif()
endforeach()
message(STATUS "Module sources have no game imports; compatibility shader bytes match")
