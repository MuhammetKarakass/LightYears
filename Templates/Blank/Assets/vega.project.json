{
	"format": "vega.project",
	"version": 1,
	"name": "Blank",
	"startupScene": "scenes/main.scene.json",
	"collisionLayers": [
		{ "bit": 0, "name": "Player" },
		{ "bit": 1, "name": "Default" },
		{ "bit": 2, "name": "Enemy" },
