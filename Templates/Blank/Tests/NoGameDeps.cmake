file(READ "${GRAPH}" graph)
if(graph MATCHES "LightYears(Game|Visual|Gameplay)|SpaceAbilitySystem|VegaSky|VegaGAS|VegaEditorLightYearsCore")
	message(FATAL_ERROR "Blank target graph contains an optional/game dependency: ${graph}")
endif()
file(GLOB_RECURSE sources "${TEMPLATE_ROOT}/Source/*" "${TEMPLATE_ROOT}/Assets/*")
get_filename_component(repository "${TEMPLATE_ROOT}/../.." ABSOLUTE)
file(GLOB_RECURSE engine "${repository}/LightYearsEngine/src/*" "${repository}/LightYearsEngine/include/*")
list(APPEND sources ${engine})
foreach(file IN LISTS sources)
	if(file MATCHES "\\.png$")
		continue()
	endif()
	file(READ "${file}" source)
	if(source MATCHES "LightYears(Game|Visual)[/\\\\]|SpaceShooterRedux|#[ \t]*include[^\r\n]*(presentation/|gameFramework/)")
		message(FATAL_ERROR "Game dependency in ${file}")
	endif()
	string(REGEX MATCHALL "#[ \t]*include[ \t]*[<\"][^>\"\r\n]+[>\"]" includes "${source}")
	foreach(include IN LISTS includes)
		string(REGEX REPLACE ".*[<\"]([^>\"]+)[>\"]" "\\1" header "${include}")
		if(EXISTS "${repository}/LightYearsGame/include/${header}" OR EXISTS "${repository}/LightYearsVisual/include/${header}")
			message(FATAL_ERROR "${file} imports a game header: ${header}")
		endif()
	endforeach()
endforeach()
message(STATUS "Blank sources, assets and transitive target graph are independent")
