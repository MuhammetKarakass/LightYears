expect-mode edit
expect-entity-count 3
open-scene scenes/main.scene.json
wait 2
select-name Player
set-prop Actor Size 2
add-component LightComponent
set-prop LightComponent Active false
expect-component BlankMovement present
expect-prop Actor Size 2
play-mode
wait 90
select-name Player
expect-prop Actor Rotation 90
expect-no-errors
stop
wait 3
select-name Player
expect-prop Actor Rotation 0
expect-prop Actor Size 2
expect-component LightComponent present
create-prefab prefabs/Player.prefab.json
expect-prefab prefabs/Player.prefab.json
place-prefab prefabs/Player.prefab.json 600 350
rename Copy
expect-prop Actor Size 2
expect-component LightComponent present
save-scene scenes/saved.scene.json
open-scene scenes/saved.scene.json
wait 3
expect-entity-count 4
select-name Copy
expect-prefab prefabs/Player.prefab.json
expect-prop Actor Size 2
expect-component LightComponent present
select-name Player
expect-prop Actor Size 2
expect-prop Actor Rotation 0
expect-no-errors
set-project-startup scenes/saved.scene.json
capture "@TEST_ROOT@/editor.png"
export "@TEST_ROOT@/export" overwrite
expect-export-ok
quit
