# Record actual CMake targets, their sources, include paths and both link edges.
# Keep generator expressions intact so the guard checks all configurations.
function(vega_record_dependencies target)
	get_property(visited GLOBAL PROPERTY BLANK_VISITED_TARGETS)
	if(target IN_LIST visited OR NOT TARGET "${target}")
		return()
	endif()
	set_property(GLOBAL APPEND PROPERTY BLANK_VISITED_TARGETS "${target}")
	foreach(property SOURCES INCLUDE_DIRECTORIES INTERFACE_INCLUDE_DIRECTORIES LINK_LIBRARIES INTERFACE_LINK_LIBRARIES MANUALLY_ADDED_DEPENDENCIES)
		get_target_property(values "${target}" ${property})
		if(values)
			set_property(GLOBAL APPEND_STRING PROPERTY BLANK_DEPENDENCY_GRAPH
				"${target} ${property}: ${values}\n")
			if(property MATCHES "LINK_LIBRARIES|MANUALLY_ADDED_DEPENDENCIES")
				foreach(value IN LISTS values)
					# Most genex edges wrap one target, such as LINK_ONLY or CONFIG.
					string(REGEX MATCHALL "[A-Za-z_][A-Za-z_0-9:+.-]*" tokens "${value}")
					foreach(token IN LISTS tokens)
						if(TARGET "${token}")
							vega_record_dependencies("${token}")
						endif()
					endforeach()
				endforeach()
			endif()
		endif()
	endforeach()
endfunction()
