# Reset only explicitly named build-tree files. Source content is always read-only.
set(root "@CMAKE_CURRENT_BINARY_DIR@/gas-content-assets")
file(MAKE_DIRECTORY "${root}/content/data")
file(GLOB source_files "@CMAKE_SOURCE_DIR@/LightYearsGame/assets/content/data/*.json")
foreach(source IN LISTS source_files)
	get_filename_component(name "${source}" NAME)
	file(SHA256 "${source}" before_${name})
	configure_file("${source}" "${root}/content/data/${name}" COPYONLY)
endforeach()
execute_process(COMMAND "${VEGA_EDITOR}" --asset-root "${root}" --editor-script
	"@CMAKE_CURRENT_BINARY_DIR@/scripts/gas-content.vegascript" RESULT_VARIABLE editor_result)
if(NOT editor_result EQUAL 0)
	message(FATAL_ERROR "VegaEditorGasContent script failed: ${editor_result}")
endif()
execute_process(COMMAND "${VEGA_CONTENT_LOADER}" --content-root "${root}"
	RESULT_VARIABLE loader_result)
if(NOT loader_result EQUAL 0)
	message(FATAL_ERROR "Game content loaders rejected authored files: ${loader_result}")
endif()
file(SHA256 "${root}/content/data/abilities.json" saved_abilities)
execute_process(COMMAND "${VEGA_EDITOR}" --asset-root "${root}" --editor-script
	"@CMAKE_CURRENT_BINARY_DIR@/scripts/gas-content-invalid.vegascript" RESULT_VARIABLE invalid_result)
file(READ "@CMAKE_CURRENT_BINARY_DIR@/scripts/gas-content-invalid.vegascript.report.txt" invalid_report)
if(invalid_result EQUAL 0 OR NOT invalid_report MATCHES "FAIL content-validate.*Dash requires positive")
	message(FATAL_ERROR "Invalid unsaved settings did not fail through the existing game validator")
endif()
file(SHA256 "${root}/content/data/abilities.json" after_invalid)
if(NOT saved_abilities STREQUAL after_invalid)
	message(FATAL_ERROR "Validation failure modified saved content")
endif()
foreach(source IN LISTS source_files)
	get_filename_component(name "${source}" NAME)
	file(SHA256 "${source}" after)
	if(NOT after STREQUAL before_${name})
		message(FATAL_ERROR "Source content changed: ${source}")
	endif()
endforeach()
