# Only this fixed build-tree copy is disposable; source assets remain untouched.
set(root "@CMAKE_CURRENT_BINARY_DIR@/campaign-scene-test-assets")
file(REAL_PATH "${root}" resolved_root)
file(REAL_PATH "@CMAKE_BINARY_DIR@" build_root)
string(FIND "${resolved_root}/" "${build_root}/" root_prefix)
if(NOT root_prefix EQUAL 0 OR NOT resolved_root MATCHES "/campaign-scene-test-assets$")
    message(FATAL_ERROR "Refusing cleanup outside campaign test assets: ${resolved_root}")
endif()
if(NOT VEGA_CAMPAIGN_POSTCHECK_ONLY)
    file(REMOVE_RECURSE "${root}")
    file(MAKE_DIRECTORY "${root}")
    file(COPY "@CMAKE_SOURCE_DIR@/LightYearsGame/assets/" DESTINATION "${root}")
    execute_process(COMMAND "${VEGA_EDITOR}" --asset-root "${root}" --editor-script
        "@CMAKE_CURRENT_BINARY_DIR@/scripts/campaign-scene.vegascript" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "VegaEditorCampaignScene failed: ${result}")
    endif()
endif()
execute_process(COMMAND "${VEGA_CAMPAIGN_CHECK}" --editor-postcheck "${root}"
    "@CMAKE_CURRENT_BINARY_DIR@/campaign-scene-temp.scene.json" RESULT_VARIABLE validation)
if(NOT validation EQUAL 0)
    message(FATAL_ERROR "LevelOne scene postcheck failed: ${validation}")
endif()
