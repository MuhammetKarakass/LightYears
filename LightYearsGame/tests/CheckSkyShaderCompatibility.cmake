file(GLOB shaders "${VEGA_ENGINE_DIR}/Modules/Sky/assets/shaders/*")
if(NOT shaders)
    message(FATAL_ERROR "No engine Sky shaders found")
endif()
# The engine loads its own Sky shaders for any name the game does not provide, so the game keeps only real overrides.
# An unchanged copy would silently pin the game to an old engine shader the next time the engine's version changes.
foreach(file IN LISTS shaders)
    get_filename_component(name "${file}" NAME)
    set(game_file "${GAME_ROOT}/LightYearsVisual/assets/shaders/${name}")
    if(NOT EXISTS "${game_file}")
        continue()
    endif()
    # Compare content, not line endings: a Windows checkout with autocrlf stores the same shader with CRLF.
    file(READ "${file}" module_text)
    file(READ "${game_file}" game_text)
    string(REPLACE "\r\n" "\n" module_text "${module_text}")
    string(REPLACE "\r\n" "\n" game_text "${game_text}")
    if(module_text STREQUAL game_text)
        message(FATAL_ERROR "Redundant copy of the engine Sky shader ${name}; delete it so the engine version is used")
    endif()
    message(STATUS "Game overrides the engine Sky shader ${name}")
endforeach()
message(STATUS "Game Sky shaders hold only overrides and game-only shaders")
