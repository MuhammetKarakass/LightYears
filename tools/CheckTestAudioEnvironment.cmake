execute_process(COMMAND "${CMAKE_CTEST_COMMAND}" --test-dir "${BUILD_ROOT}" --show-only=json-v1
	OUTPUT_VARIABLE listing RESULT_VARIABLE result)
if(NOT result EQUAL 0)
	message(FATAL_ERROR "Cannot list CTest environment")
endif()
string(JSON count LENGTH "${listing}" tests)
math(EXPR last "${count} - 1")
set(game_e2e FALSE)
foreach(index RANGE 0 ${last})
	string(JSON name GET "${listing}" tests ${index} name)
	string(JSON properties GET "${listing}" tests ${index} properties)
	if(NOT properties MATCHES "VEGA_MUTE_AUDIO=1")
		message(FATAL_ERROR "${name} lacks VEGA_MUTE_AUDIO=1")
	endif()
	if(name STREQUAL "LightYearsGameHUDDamageEventE2E")
		set(game_e2e TRUE)
	endif()
endforeach()
if(EXPECT_GAME AND NOT game_e2e)
	message(FATAL_ERROR "Sample game E2E was not registered")
endif()
message(STATUS "Verified mute environment for all ${count} tests, sample game E2E: ${game_e2e}")
